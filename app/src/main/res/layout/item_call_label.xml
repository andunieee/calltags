<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/normal_icon_size"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/call_label_remove"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_label"
        android:padding="@dimen/normal_margin"
        android:src="@drawable/ic_cross_vector" />

    <ImageView
        android:id="@+id/call_label_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/medium_margin"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_block_vector"
        android:visibility="gone" />

    <TextView
        android:id="@+id/call_label_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/bigger_text_size" />
</LinearLayout>
